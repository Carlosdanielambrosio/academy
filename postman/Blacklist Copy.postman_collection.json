	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "user_login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let responseJson = pm.response.json();\r",
									"\r",
									"\r",
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"\r",
									"if (responseJson.user && responseJson.user._id && responseJson.token) {\r",
									"    pm.globals.set(\"tokenAdmin\", responseJson.token);\r",
									"    pm.globals.set(\"userId\", responseJson.user._id);\r",
									"    console.log(\"Token and userId saved:\", responseJson.user._id);\r",
									"} else {\r",
									"    console.warn(\"Missing user or token in response:\", responseJson);\r",
									"}\r",
									"\r",
									"\r",
									"pm.test(\"Welcome Message\", function () {\r",
									"    pm.environment.set(\"responseMessage\", responseJson.msg);\r",
									"});\r",
									"\r",
									"\r",
									"if (responseJson.user && responseJson.user._id) {\r",
									"    pm.test(\"Verify ID\", function () {\r",
									"        pm.expect(responseJson.user._id).to.eql(pm.globals.get(\"userId\"));\r",
									"    });\r",
									"}\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\r\n  \"mail\": \"{{userMail}}\",\r\n  \"password\": \"{{userPassword}}\"\r\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"login"
							]
						}
					},
					"response": []
				},
